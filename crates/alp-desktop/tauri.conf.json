{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/refs/heads/v2/crates/tauri-cli/schema.json",
  "productName": "Audio Labs Pro",
  "version": "0.1.0",
  "identifier": "io.github.zvirox.audio-labs-pro",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "bundle": {
    "active": false
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Audio Labs Pro",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
